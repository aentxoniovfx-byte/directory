/* =========================================================
   ON-CALL COORDINATORS
========================================================= */

function renderOnCallCoordinators(){

  const cells =
    document.querySelectorAll(
      "#oncallCoordinatorsTable td"
    );


  cells.forEach(cell=>{

    const row =
      Number(cell.dataset.row);

    const col =
      Number(cell.dataset.col);

    const value =
      onCallCoordinators[row]?.[col] || "";


    if(adminMode){

      cell.innerHTML = `

        <input
          class="oncall-edit"
          data-row="${row}"
          data-col="${col}"
          value="${escapeHTML(value)}"
          autocomplete="off">

      `;

    }else{

      cell.textContent =
        value;

    }

  });


  document.querySelectorAll(
    ".oncall-edit"
  ).forEach(input=>{

    input.addEventListener(
      "input",
      ()=>{

        const row =
          Number(input.dataset.row);

        const col =
          Number(input.dataset.col);


        if(!onCallCoordinators[row])
          onCallCoordinators[row]=[];


        onCallCoordinators[row][col] =
          input.value;


        saveJSON(
          "paramedOnCallCoordinators",
          onCallCoordinators
        );

      }
    );

  });

}


/* =========================================================
   DIRECTORY EDITING
========================================================= */

function makeDirectoryEditable(){

  const tables =
    document.querySelectorAll(
      ".directory-table"
    );


  tables.forEach(
    (table,tableIndex)=>{

      const rows =
        table.querySelectorAll(
          "tbody tr"
        );


      rows.forEach(
        (row,rowIndex)=>{

          const cells =
            row.querySelectorAll(
              "td"
            );


          cells.forEach(
            (cell,colIndex)=>{

              const key =
                `${tableIndex}-${rowIndex}-${colIndex}`;


              if(adminMode){

                const saved =
                  directoryEdits[key];

                const value =
                  saved !== undefined
                  ? saved
                  : cell.textContent;


                cell.innerHTML = `

                  <input
                    class="directory-edit"
                    data-key="${key}"
                    value="${escapeHTML(value)}"
                    autocomplete="off">

                `;

              }

            }
          );

        }
      );

    }
  );


  document.querySelectorAll(
    ".directory-edit"
  ).forEach(input=>{

    input.addEventListener(
      "input",
      ()=>{

        directoryEdits[
          input.dataset.key
        ] =
          input.value;


        saveJSON(
          "paramedDirectoryEdits",
          directoryEdits
        );

      }
    );

  });

}


function renderDirectory(){

  if(!adminMode){

    location.reload();

    return;

  }

  makeDirectoryEditable();

}


/* =========================================================
   CALENDAR
========================================================= */

const calendarOverlay =
  document.getElementById(
    "calendarOverlay"
  );

const calendarButton =
  document.getElementById(
    "calendarButton"
  );

const calendarClose =
  document.getElementById(
    "calendarClose"
  );

const calendarMonth =
  document.getElementById(
    "calendarMonth"
  );

const calendarDays =
  document.getElementById(
    "calendarDays"
  );

const currentDate =
  document.getElementById(
    "currentDate"
  );

const calendarButtonDate =
  document.getElementById(
    "calendarButtonDate"
  );


let selectedDate =
  new Date();


let calendarView =
  new Date(
    selectedDate.getFullYear(),
    selectedDate.getMonth(),
    1
  );


const monthNames=[

  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December"

];


const weekdayNames=[

  "Sunday",
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday"

];


function formatDate(date){

  return (

    weekdayNames[date.getDay()]
    + ", "
    + monthNames[date.getMonth()]
    + " "
    + date.getDate()

  );

}


function sameDate(a,b){

  return (

    a.getFullYear()===b.getFullYear() &&
    a.getMonth()===b.getMonth() &&
    a.getDate()===b.getDate()

  );

}


function renderCalendar(){

  const year =
    calendarView.getFullYear();

  const month =
    calendarView.getMonth();


  calendarMonth.textContent =
    monthNames[month] +
    " " +
    year;


  calendarDays.innerHTML="";


  const firstDay =
    new Date(
      year,
      month,
      1
    );


  const lastDay =
    new Date(
      year,
      month + 1,
      0
    );


  const previousLast =
    new Date(
      year,
      month,
      0
    );


  const start =
    firstDay.getDay();


  const total =
    Math.ceil(
      (
        start +
        lastDay.getDate()
      ) / 7
    ) * 7;


  const today =
    new Date();


  for(
    let i=0;
    i<total;
    i++
  ){

    const button =
      document.createElement(
        "button"
      );


    button.type="button";

    button.className =
      "calendar-day";


    let date;
    let day;
    let other=false;


    if(i<start){

      day =
        previousLast.getDate()
        - start
        + i
        + 1;


      date =
        new Date(
          year,
          month-1,
          day
        );


      other=true;

    }else if(
      i-start >=
      lastDay.getDate()
    ){

      day =
        i-start -
        lastDay.getDate()
        + 1;


      date =
        new Date(
          year,
          month+1,
          day
        );


      other=true;

    }else{

      day =
        i-start+1;


      date =
        new Date(
          year,
          month,
          day
        );

    }


    button.textContent =
      day;


    if(other)
      button.classList.add(
        "other"
      );


    if(
      sameDate(
        date,
        today
      )
    )
      button.classList.add(
        "today"
      );


    if(
      sameDate(
        date,
        selectedDate
      )
    )
      button.classList.add(
        "selected"
      );


    button.addEventListener(
      "click",
      ()=>{

        selectedDate =
          date;


        currentDate.textContent =
          formatDate(
            selectedDate
          );


        calendarButtonDate.textContent =
          selectedDate.getDate();


        calendarOverlay.classList.remove(
          "show"
        );


        renderCalendar();

      }
    );


    calendarDays.appendChild(
      button
    );

  }

}


calendarButton.addEventListener(
  "click",
  ()=>{

    renderCalendar();

    calendarOverlay.classList.add(
      "show"
    );

  }
);


calendarClose.addEventListener(
  "click",
  ()=>{

    calendarOverlay.classList.remove(
      "show"
    );

  }
);


calendarOverlay.addEventListener(
  "click",
  e=>{

    if(
      e.target ===
      calendarOverlay
    ){

      calendarOverlay.classList.remove(
        "show"
      );

    }

  }
);


/* =========================================================
   INITIALIZE
========================================================= */

currentDate.textContent =
  formatDate(
    selectedDate
  );


calendarButtonDate.textContent =
  selectedDate.getDate();


renderCalendar();

render();

renderOnCallCoordinators();

refreshEditableFields();

</script>

