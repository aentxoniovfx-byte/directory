/* =========================================================
   CALENDAR
========================================================= */

.calendar-overlay,
.admin-overlay{
  position:fixed;
  inset:0;

  z-index:1000;

  display:flex;
  align-items:flex-start;
  justify-content:flex-end;

  padding:75px 30px 30px;

  background:
    rgba(0,20,40,.16);

  backdrop-filter:blur(5px);

  opacity:0;
  pointer-events:none;

  transition:opacity .25s ease;
}

.calendar-overlay.show,
.admin-overlay.show{
  opacity:1;
  pointer-events:auto;
}

.calendar-popup{
  width:330px;

  padding:20px;

  border:
    1px solid
    var(--line);

  border-radius:24px;

  background:var(--panel-solid);

  box-shadow:
    0 20px 60px rgba(20,50,90,.20),
    0 0 30px rgba(var(--accent-rgb),.12);

  transform:
    translateY(-12px)
    scale(.97);

  transition:
    transform .3s
    cubic-bezier(.2,.8,.2,1);
}

.calendar-overlay.show .calendar-popup{
  transform:
    translateY(0)
    scale(1);
}

.calendar-head{
  display:flex;
  align-items:center;
  justify-content:space-between;

  margin-bottom:16px;
}

.calendar-month{
  font-size:18px;
  font-weight:750;
}

.calendar-close{
  width:30px;
  height:30px;

  border:0;
  border-radius:50%;

  background:var(--input);
  color:var(--secondary);

  cursor:pointer;
  font-size:17px;
}

.weekdays,
.calendar-days{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:4px;
}

.weekdays{
  margin-bottom:6px;
}

.weekdays div{
  text-align:center;

  color:var(--muted);

  font-size:9px;
  font-weight:700;
}

.calendar-day{
  aspect-ratio:1;

  display:flex;
  align-items:center;
  justify-content:center;

  border:0;
  border-radius:10px;

  background:transparent;
  color:var(--text);

  font-size:12px;

  cursor:pointer;
  transition:.2s ease;
}

.calendar-day:hover{
  background:
    rgba(var(--accent-rgb),.12);

  color:var(--blue);
}

.calendar-day.other{
  color:var(--muted);
  opacity:.4;
}

.calendar-day.today{
  background:
    rgba(var(--accent-rgb),.12);

  color:var(--blue);

  box-shadow:
    inset 0 0 0 1px
    rgba(var(--accent-rgb),.25);
}

.calendar-day.selected{
  background:
    linear-gradient(
      145deg,
      var(--blue),
      var(--cyan)
    );

  color:#fff;

  box-shadow:
    0 0 16px
    rgba(var(--accent-rgb),.42);
}


/* =========================================================
   ADMIN
========================================================= */

.admin-overlay{
  align-items:center;
  justify-content:center;

  padding:20px;

  z-index:1100;

  background:
