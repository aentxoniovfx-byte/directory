                  adminMode
                  ?
                  `<input
                    class="edit-input area-edit"
                    data-code="${escapeHTML(code)}"
                    data-field="coordinator"
                    value="${escapeHTML(d.coordinator)}"
                    autocomplete="off">`
                  :
                  `<div class="person">
                    ${escapeHTML(d.coordinator)}
                  </div>`
                }

              </div>

            </div>


            <div class="info">

              <div style="width:100%">

                <div class="label">
                  Supervisor
                </div>

                ${
                  adminMode
                  ?
                  `<input
                    class="edit-input area-edit"
                    data-code="${escapeHTML(code)}"
                    data-field="supervisor"
                    value="${escapeHTML(d.supervisor)}"
                    autocomplete="off">`
                  :
                  `<div
                    style="
                      display:flex;
                      align-items:center;
                    ">

                    <button
                      class="supervisor"
                      type="button"
                      data-code="${escapeHTML(code)}">

                      ${escapeHTML(d.supervisor)}

                    </button>

                    ${
                      d.phone
                      ?
                      `<div
                        class="phone"
                        id="phone-${escapeHTML(code).replace(/\s/g,"-")}">

                        <a
                          href="tel:${d.phone.replace(/[^0-9+]/g,"")}">

                          ${escapeHTML(d.phone)}

                        </a>

                      </div>`
                      :
                      ""
                    }

                  </div>`
                }

              </div>

            </div>


            ${
              adminMode
              ?
              `<div class="info">

                <div style="width:100%">

                  <div class="label">
                    Supervisor Phone
                  </div>

                  <input
                    class="edit-input area-edit"
                    data-code="${escapeHTML(code)}"
                    data-field="phone"
                    value="${escapeHTML(d.phone)}"
                    placeholder="Phone…"
                    autocomplete="off">

                </div>

              </div>`
              :
              ""
            }


            <div class="oncall-cell">

              <div style="width:100%">

                <div class="oncall-label">

                  <span class="oncall-status"></span>

                  On Call

                </div>

                ${
                  adminMode
                  ?
                  `<input
                    class="oncall-input"
                    data-code="${escapeHTML(code)}"
                    value="${escapeHTML(onCall)}"
                    placeholder="Enter name…"
                    autocomplete="off">`
                  :
                  `<div class="person">

                    ${
                      onCall
                      ? escapeHTML(onCall)
                      : "No on-call coverage"
                    }

                  </div>`
                }

              </div>

            </div>

          </div>

        </div>

      </article>

      `;

    }).join("");


  /* =======================================================
     AREA BUTTON TOGGLE
  ======================================================= */

  el.querySelectorAll(
    ".area"
  ).forEach(area=>{

    area.addEventListener(
      "click",
      e=>{

        e.stopPropagation();

        const card =
          area.closest(".card");

        const wasOpen =
          card.classList.contains("open");


        /*
          Close every other area
        */

        el.querySelectorAll(
          ".card.open"
        ).forEach(other=>{

          other.classList.remove(
            "open"
          );

          const otherButton =
            other.querySelector(
              ".area"
            );

          if(otherButton){

            otherButton.setAttribute(
              "aria-expanded",
              "false"
            );

          }

        });


        /*
          Open selected area
        */

        if(!wasOpen){

          card.classList.add(
            "open"
          );

          area.setAttribute(
            "aria-expanded",
