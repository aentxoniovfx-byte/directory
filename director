    notes:
      document.getElementById("notesNursing")
  },

  intake:{
    coordinator:
      document.getElementById("coverageIntake"),

    notes:
      document.getElementById("notesIntake")
  }

};


Object.keys(
  coverageFields
).forEach(key=>{

  coverageFields[key]
    .coordinator
    .value =
      coverageData[key]?.coordinator || "";

  coverageFields[key]
    .notes
