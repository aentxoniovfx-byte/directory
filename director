========================================================= */

function getAreaData(d){

  const code=d[0];

  const edits =
    customData[code] || {};

  return {

    code:code,

    area:
      edits.area ?? d[1],

    coordinator:
      edits.coordinator ?? d[2],

    supervisor:
      edits.supervisor ?? d[3],

    phone:
      edits.phone ?? d[4]

  };

}


function saveAreaEdit(
  code,
  field,
  value
){

  if(!adminMode)
    return;

  if(!customData[code])
    customData[code]={};

  customData[code][field]=value;

  saveJSON(
    "paramedAreaEdits",
    customData
  );

}


function saveOnCall(
  code,
  value
){

  if(!adminMode)
    return;

  value=value.trim();

  if(value)
    onCallData[code]=value;
  else
    delete onCallData[code];

  saveJSON(
    "paramedOnCall",
    onCallData
  );

}


function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


