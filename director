    input.addEventListener(
      "click",
      e=>e.stopPropagation()
    );

    input.addEventListener(
      "keydown",
      e=>e.stopPropagation()
    );

    input.addEventListener(
      "input",
      ()=>{

        const code =
          input.dataset.code;

        const value =
          input.value.trim();

        const card =
