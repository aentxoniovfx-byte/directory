<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Paramed Daily Operations</title>

<style>

:root{
  --bg:#eef0ff;
  --panel:rgba(255,255,255,.58);
  --panel-solid:#ffffff;

  --text:#17172b;
  --secondary:#626886;
  --muted:#9298b2;

  --line:rgba(28,112,196,.22);

  --blue:#1C70C4;
  --cyan:#3FA9F5;
  --green:#00d995;
  --purple:#a855f7;
  --orange:#ff8b32;

  --input:rgba(248,251,255,.72);

  --blue-bg:rgba(28,112,196,.15);
  --green-bg:rgba(0,217,149,.14);
  --purple-bg:rgba(168,85,247,.14);

  --accent-rgb:28,112,196;
  --accent-2-rgb:63,169,245;

  --shadow:
    0 12px 35px rgba(28,112,196,.12);

  --glow-blue:
    0 0 14px rgba(28,112,196,.38),
    0 0 32px rgba(28,112,196,.14);
}

body.dark{
  --bg:#080704;
  --panel:rgba(22,18,8,.66);
  --panel-solid:#17140a;

  --text:#fffbea;
  --secondary:#b9ae8c;
  --muted:#766f5a;

  --line:rgba(229,194,22,.25);

  --blue:#E5C216;
  --cyan:#FFE45C;

  --green:#00e69a;
  --purple:#bd72ff;
  --orange:#FF7A00;

  --input:rgba(25,21,8,.82);

  --blue-bg:rgba(229,194,22,.18);
  --green-bg:rgba(0,220,145,.17);
  --purple-bg:rgba(175,80,255,.18);

  --accent-rgb:229,194,22;
  --accent-2-rgb:255,228,92;

  --shadow:
    0 15px 45px rgba(0,0,0,.48);

  --glow-blue:
    0 0 16px rgba(229,194,22,.45),
    0 0 38px rgba(229,194,22,.18);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    "SF Pro Text",
    Inter,
    "Helvetica Neue",
    Arial,
    sans-serif;

  background:
    radial-gradient(
      circle at 10% -10%,
      rgba(var(--accent-rgb),.18),
      transparent 32%
    ),
    radial-gradient(
      circle at 92% 5%,
      rgba(var(--accent-2-rgb),.12),
      transparent 30%
    ),
    var(--bg);

  color:var(--text);

  -webkit-font-smoothing:antialiased;

  transition:
    background .4s ease,
    color .35s ease;
}

button,
input,
textarea{
  font-family:inherit;
}

.wrap{
  width:100%;
  max-width:1500px;
  margin:0 auto;
  padding:24px 28px 60px;
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.date-area{
  display:flex;
  align-items:center;
  gap:12px;
}

.date-icon{
  width:45px;
  height:45px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:14px;

  background:
    linear-gradient(
      145deg,
      rgba(var(--accent-rgb),.24),
      rgba(var(--accent-2-rgb),.10)
    );

  border:
    1px solid
    rgba(var(--accent-rgb),.58);

  color:var(--blue);
  font-size:21px;

  box-shadow:
    0 0 18px rgba(var(--accent-rgb),.28),
    inset 0 0 18px rgba(var(--accent-rgb),.09);
}

.date-title{
  font-size:21px;
  font-weight:750;
  letter-spacing:-.025em;
}

.date-sub{
  margin-top:3px;
  color:var(--secondary);
  font-size:13px;
}

.top-actions{
  display:flex;
  align-items:center;
  gap:7px;
}

.small-button{
  height:37px;
  min-width:37px;
  padding:0 12px;

  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;

  border:
    1px solid
    var(--line);

  border-radius:12px;

  background:var(--panel);

  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);

  color:var(--text);

  font-size:12px;
  font-weight:700;

  cursor:pointer;

  transition:.25s ease;
}

.small-button:hover{
  border-color:
    rgba(var(--accent-rgb),.72);

  box-shadow:
    0 0 0 3px rgba(var(--accent-rgb),.08),
    0 0 22px rgba(var(--accent-rgb),.25);
}

.small-button:active{
  transform:scale(.95);
}

.calendar-button{
  min-width:145px;
}

.calendar-button .calendar-date{
  color:var(--blue);
  font-weight:800;
}


/* =========================================================
   WORKSPACE
========================================================= */

.workspace{
  display:grid;
  grid-template-columns:minmax(0,1fr) 370px;
  gap:20px;
  align-items:start;
}

.panel{
  background:var(--panel);

  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);

  border:
    1px solid
    var(--line);

  border-radius:18px;

  box-shadow:var(--shadow);

  overflow:hidden;

  transition:
    border-color .3s ease,
    box-shadow .3s ease;
}

.panel:hover{
  border-color:
    rgba(var(--accent-rgb),.42);
}

.panel + .panel{
  margin-top:14px;
}

.panel-header{
  padding:15px 18px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  border-bottom:
    1px solid
    var(--line);
}

.panel-title{
  margin:0;

  font-size:16px;
  font-weight:750;

  letter-spacing:-.015em;
}

.panel-sub{
  margin:4px 0 0;

  color:var(--secondary);

  font-size:12px;
}


/* =========================================================
   AREAS
========================================================= */

.results{
  display:flex;
  flex-direction:column;
  gap:6px;

  padding:10px;
}

.card{
  display:flex;
  align-items:stretch;

  width:100%;
  min-height:46px;

  overflow:hidden;

  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.72),
      rgba(247,249,255,.58)
    );

  border:
    1px solid
    var(--line);

  border-radius:10px;

  box-shadow:
    0 2px 7px rgba(0,0,0,.025);

  transition:
    background .25s ease,
    border-color .25s ease,
    box-shadow .25s ease,
    transform .2s ease,
    min-height .3s ease;
}

body.dark .card{
  background:
    linear-gradient(
      90deg,
      rgba(29,24,10,.86),
      rgba(20,17,9,.74)
    );
}

.card:hover{
  transform:translateY(-1px);
}


/* =========================================================
   ON-CALL ACTIVE ROW
========================================================= */

.card.oncall-active{

  min-height:60px;

  background:
    linear-gradient(
      90deg,
      rgba(var(--accent-rgb),.34),
      rgba(var(--accent-2-rgb),.22),
      rgba(var(--accent-rgb),.12)
    );

  border-color:
    rgba(var(--accent-rgb),.92);

  box-shadow:
    0 0 0 1px rgba(var(--accent-rgb),.42),
    0 0 20px rgba(var(--accent-rgb),.42),
    0 0 44px rgba(var(--accent-rgb),.18);
}

body.dark .card.oncall-active{

  background:
    linear-gradient(
      90deg,
      rgba(229,194,22,.38),
      rgba(255,228,92,.22),
      rgba(229,194,22,.11)
    );

  border-color:
    rgba(229,194,22,.96);

  box-shadow:
    0 0 0 1px rgba(229,194,22,.46),
    0 0 22px rgba(229,194,22,.48),
    0 0 48px rgba(229,194,22,.20);
}


/* =========================================================
   AREA BUTTON
========================================================= */

.area{
  flex:1;
  min-width:0;

  min-height:46px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:9px 14px;

  border:0;

  background:
    linear-gradient(
      135deg,
      rgba(var(--accent-rgb),.055),
      rgba(var(--accent-2-rgb),.025)
    );

  color:var(--text);

  font-size:13px;
  font-weight:700;

  text-align:left;

  cursor:pointer;
  user-select:none;

  transition:
    background .25s ease,
    color .25s ease,
    box-shadow .25s ease,
    transform .2s ease;
}

.area:hover{
  background:
    linear-gradient(
      135deg,
      rgba(var(--accent-rgb),.13),
      rgba(var(--accent-2-rgb),.06)
    );

  color:var(--blue);

  box-shadow:
    inset 0 0 18px
    rgba(var(--accent-rgb),.06);
}

.area:active{
  transform:scale(.995);
}

.area:focus-visible{
  outline:none;

  box-shadow:
    inset 0 0 0 2px
    rgba(var(--accent-rgb),.55),
    0 0 14px
    rgba(var(--accent-rgb),.18);
}

.area-name{
  display:flex;
  align-items:center;

  min-width:0;

  overflow:hidden;

  text-overflow:ellipsis;
  white-space:nowrap;
}

.area-indicator{
  flex:0 0 auto;

  width:8px;
  height:8px;

  margin-right:10px;

  border-radius:50%;

  background:
    rgba(var(--accent-rgb),.35);

  box-shadow:
    0 0 7px
    rgba(var(--accent-rgb),.20);

  transition:
    background .25s ease,
    box-shadow .25s ease,
    transform .25s ease;
}

.card.open .area-indicator{
  background:var(--blue);

  box-shadow:
    0 0 7px var(--blue),
    0 0 15px
    rgba(var(--accent-rgb),.55);

  transform:scale(1.15);
}

.card.open .area{
  background:
    linear-gradient(
      135deg,
      rgba(var(--accent-rgb),.16),
      rgba(var(--accent-2-rgb),.07)
    );

  color:var(--blue);

  box-shadow:
    inset 0 0 20px
    rgba(var(--accent-rgb),.08);
}

.code{
  margin-left:6px;

  color:var(--muted);

  font-size:11px;
  font-weight:600;
}


/* =========================================================
   DETAILS
========================================================= */

.details-wrapper{
  display:grid;
  grid-template-columns:0fr;

  opacity:0;
  overflow:hidden;

  transition:
    grid-template-columns .4s cubic-bezier(.4,0,.2,1),
    opacity .2s ease;
}

.card.open .details-wrapper{
  grid-template-columns:1fr;
  opacity:1;
}

.details{
  min-width:0;

  display:flex;
  align-items:stretch;

  overflow:hidden;

  border-left:1px solid transparent;
}

.card.open .details{
  border-left-color:var(--line);
}

.info{
  min-width:190px;

  display:flex;
  align-items:center;

  padding:0 15px;

  white-space:nowrap;
}

.info + .info{
  border-left:
    1px solid
    var(--line);
}

.label{
  margin-bottom:4px;

  color:var(--secondary);

  font-size:9px;
  font-weight:750;

  letter-spacing:.075em;
  text-transform:uppercase;
}

.person{
  color:var(--text);

  font-size:13px;
  font-weight:620;
}

.edit-input{
  width:100%;
  height:29px;

  padding:0 8px;

  border:
    1px solid
    var(--line);

  border-radius:7px;

  outline:none;

  background:var(--input);
  color:var(--text);

  font-size:12px;
  font-weight:600;
}

.edit-input:focus,
.oncall-input:focus,
.coverage-input:focus,
.coverage-notes:focus,
.important-notes:focus,
.directory-edit:focus{
  border-color:var(--blue);

  box-shadow:
    0 0 0 3px rgba(var(--accent-rgb),.10),
    0 0 13px rgba(var(--accent-rgb),.18);
}

.supervisor{
  padding:0;

  border:0;
  background:none;

  color:var(--blue);

  font-size:13px;
  font-weight:650;

  cursor:pointer;
}

.supervisor:hover{
  color:var(--cyan);

  text-shadow:
    0 0 9px
    rgba(var(--accent-rgb),.48);
}

.phone{
  max-width:0;

  margin-left:0;

  overflow:hidden;

  opacity:0;
  white-space:nowrap;

  transition:
    max-width .3s ease,
    margin-left .3s ease,
    opacity .2s ease;
}

.phone.show{
  max-width:150px;

  margin-left:10px;

  opacity:1;
}

.phone a{
  color:var(--text);

  font-size:12px;
  font-weight:650;

  text-decoration:none;
}


/* =========================================================
   ON CALL — NORMAL
========================================================= */

.oncall-cell{

  flex:0 0 245px;
  min-width:245px;

  display:flex;
  align-items:center;

  padding:8px 16px;

  background:
    linear-gradient(
      90deg,
      rgba(var(--accent-rgb),.045),
      rgba(var(--accent-rgb),.09)
    );

  border-left:
    1px solid
    rgba(var(--accent-rgb),.22);

  transition:
    flex-basis .3s ease,
    min-width .3s ease,
    padding .3s ease,
    background .3s ease,
    border-color .3s ease,
    box-shadow .3s ease;
}


/* =========================================================
   ON CALL — ACTIVE
========================================================= */

.card.oncall-active .oncall-cell{

  flex:1 1 360px;
  min-width:360px;

  padding:
    13px 21px;

  background:
    linear-gradient(
      90deg,
      rgba(var(--accent-rgb),.17),
      rgba(var(--accent-2-rgb),.27),
      rgba(var(--accent-rgb),.14)
    );

  border-left:
    2px solid
    rgba(var(--accent-rgb),.78);

  box-shadow:
    inset 0 0 25px
      rgba(var(--accent-rgb),.11),
    0 0 20px
      rgba(var(--accent-rgb),.12);
}


/* =========================================================
   ON CALL LABEL
========================================================= */

.oncall-label{

  margin-bottom:4px;

  color:var(--secondary);

  font-size:9px;
  font-weight:750;

  letter-spacing:.075em;
  text-transform:uppercase;

  transition:
    color .25s ease,
    font-size .25s ease,
    text-shadow .25s ease;
}

.card.oncall-active .oncall-label{

  color:var(--blue);

  font-size:10px;
  font-weight:850;

  letter-spacing:.10em;

  text-shadow:
    0 0 9px
    rgba(var(--accent-rgb),.62);
}


/* =========================================================
   ON CALL NAME
========================================================= */

.card.oncall-active .oncall-cell .person{

  font-size:15px;
  font-weight:800;

  color:var(--text);

  text-shadow:
    0 0 8px
    rgba(var(--accent-rgb),.34);
}


/* =========================================================
   ON CALL STATUS — DAY
========================================================= */

@keyframes onCallPulse{

  0%,
  100%{
    opacity:1;
    transform:scale(1);

    box-shadow:
      0 0 6px #7B2CBF,
      0 0 14px #7B2CBF,
      0 0 25px rgba(123,44,191,.95);
  }

  50%{
    opacity:.32;
    transform:scale(.72);

    box-shadow:
      0 0 2px #7B2CBF,
      0 0 6px #7B2CBF,
      0 0 12px rgba(123,44,191,.55);
  }

}


/* =========================================================
   ON CALL STATUS — NIGHT
========================================================= */

@keyframes onCallPulseNight{

  0%,
  100%{
    opacity:1;
    transform:scale(1);

    box-shadow:
      0 0 6px #FF7A00,
      0 0 14px #FF7A00,
      0 0 25px rgba(255,122,0,.95);
  }

  50%{
    opacity:.32;
    transform:scale(.72);

    box-shadow:
      0 0 2px #FF7A00,
      0 0 6px #FF7A00,
      0 0 12px rgba(255,122,0,.55);
  }

}

.oncall-status{

  display:inline-block;

  width:7px;
  height:7px;

  margin-right:5px;

  border-radius:50%;

  background:#aeb9c7;

  transition:
    width .25s ease,
    height .25s ease,
    margin-right .25s ease,
    box-shadow .25s ease;
}

.card.oncall-active .oncall-status{

  width:9px;
  height:9px;

  margin-right:7px;

  background:#7B2CBF;

  animation:
    onCallPulse 1.15s ease-in-out infinite;
}

body.dark .card.oncall-active .oncall-status{

  background:#FF7A00;

  animation:
    onCallPulseNight 1.15s ease-in-out infinite;
}


/* =========================================================
   ON CALL INPUT
========================================================= */

.oncall-input{

  width:165px;
  height:28px;

  padding:0 8px;

  border:
    1px solid
    var(--line);

  border-radius:7px;

  outline:none;

  background:var(--input);
  color:var(--text);

  font-size:12px;
}

.card.oncall-active .oncall-input{

  width:100%;
  height:35px;

  font-size:13px;
  font-weight:700;

  border-color:
    rgba(var(--accent-rgb),.60);

  background:
    rgba(var(--accent-rgb),.11);

  box-shadow:
    0 0 11px
    rgba(var(--accent-rgb),.14);
}

body.dark .card.oncall-active .oncall-cell{

  background:
    linear-gradient(
      90deg,
      rgba(229,194,22,.18),
      rgba(255,228,92,.30),
      rgba(229,194,22,.13)
    );

  border-left-color:
    rgba(229,194,22,.86);

  box-shadow:
    inset 0 0 27px
      rgba(229,194,22,.12),
    0 0 22px
      rgba(229,194,22,.15);
}

body.dark .card.oncall-active .oncall-label{

  color:#FFE45C;

  text-shadow:
    0 0 10px
    rgba(229,194,22,.72);
}

body.dark .card.oncall-active .oncall-input{

  border-color:
    rgba(229,194,22,.62);

  background:
    rgba(229,194,22,.12);

  box-shadow:
    0 0 13px
    rgba(229,194,22,.18);
}


/* =========================================================
   COVERAGE
========================================================= */

.coverage-grid{
  display:flex;
  flex-direction:column;
  gap:8px;

  padding:10px;
}

.coverage-card{
  padding:12px;

  border-radius:12px;

  transition:.25s ease;
}

.coverage-card.psw{
  background:
    linear-gradient(
      135deg,
      rgba(0,130,255,.16),
      rgba(0,190,255,.06)
    );

  border:
    1px solid
    rgba(0,140,255,.40);

  box-shadow:
    inset 0 0 18px rgba(0,140,255,.05),
    0 0 14px rgba(0,140,255,.06);
}

.coverage-card.psw:hover{
  border-color:
    rgba(0,170,255,.72);

  box-shadow:
    0 0 18px
    rgba(0,150,255,.16);
}

.coverage-card.nursing{
  background:
    linear-gradient(
      135deg,
      rgba(0,200,125,.17),
      rgba(0,230,150,.06)
    );

  border:
    1px solid
    rgba(0,205,130,.40);

  box-shadow:
    inset 0 0 18px rgba(0,205,130,.05),
    0 0 14px rgba(0,205,130,.06);
}

.coverage-card.nursing:hover{
  border-color:
    rgba(0,225,150,.72);

  box-shadow:
    0 0 18px
    rgba(0,220,145,.16);
}

.coverage-card.intake{
  background:
    linear-gradient(
      135deg,
      rgba(155,80,255,.18),
      rgba(190,100,255,.07)
    );

  border:
    1px solid
    rgba(160,85,255,.43);

  box-shadow:
    inset 0 0 18px rgba(160,85,255,.05),
    0 0 14px rgba(160,85,255,.06);
}

.coverage-card.intake:hover{
  border-color:
    rgba(190,105,255,.75);

  box-shadow:
    0 0 18px
    rgba(175,90,255,.17);
}

.coverage-category{
  display:flex;
  align-items:center;
  gap:7px;

  margin-bottom:9px;

  font-size:11px;
  font-weight:800;

  letter-spacing:.06em;
  text-transform:uppercase;
}

.psw .coverage-category{
  color:#0098ff;
}

.nursing .coverage-category{
  color:var(--green);
}

.intake .coverage-category{
  color:var(--purple);
}

.coverage-dot{
  width:7px;
  height:7px;
  border-radius:50%;
}

.psw .coverage-dot{
  background:#0098ff;
  box-shadow:0 0 10px #0098ff;
}

.nursing .coverage-dot{
  background:var(--green);
  box-shadow:0 0 10px var(--green);
}

.intake .coverage-dot{
  background:var(--purple);
  box-shadow:0 0 10px var(--purple);
}

.coverage-label{
  display:block;

  margin:0 0 4px;

  color:var(--secondary);

  font-size:9px;
  font-weight:750;

  letter-spacing:.07em;
  text-transform:uppercase;
}

.coverage-input,
.coverage-notes{
  width:100%;

  border:
    1px solid
    var(--line);

  border-radius:7px;

  outline:none;

  background:var(--input);
  color:var(--text);
}

.coverage-input{
  height:31px;

  padding:0 8px;
  margin-bottom:8px;

  font-size:12px;
}

.coverage-card .coverage-input{
  font-weight:800;
}

.coverage-card.psw .coverage-input{
  color:#0098ff;
  text-shadow:0 0 8px rgba(0,152,255,.30);
}

.coverage-card.nursing .coverage-input{
  color:#00d995;
  text-shadow:0 0 8px rgba(0,217,149,.30);
}

.coverage-card.intake .coverage-input{
  color:#a855f7;
  text-shadow:0 0 8px rgba(168,85,247,.30);
}

body.dark .coverage-card.psw .coverage-input{
  color:#3FA9F5;
  text-shadow:0 0 9px rgba(63,169,245,.38);
}

